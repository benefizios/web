# Benefizios · plantilla de variables de entorno.
# Copiá este archivo como `.env.local` y completá los valores reales.
# `.env.local` está en .gitignore — nunca subas secretos al repo.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Resend ──
RESEND_API_KEY=
EMAIL_FROM=no-reply@benefizios.com

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
